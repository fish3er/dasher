polish_model/

# Wagi modeli — GGUF ma 5+ GB, nie wolno mu trafić do historii gita
models/
*.gguf

__pycache__/
*.pyc

# cache sha256 modelu — lokalny, zależny od mtime pliku
results/.model_hash_cache.json

# runy smoke to weryfikacja robocza, nie wynik
results/*_smoke/

# częściowe snapshoty trwającego runu
results/partial_*/

# transkrypt podcastu (prawa autorskie; repo jest publiczne) — śledzone tylko README i source.json
corpus_context_podcast_pl/*.txt
corpus_context_podcast_pl/*.meta.json

# indeks słownika G&V (gv_index.py) — lokalny, odtwarzalny z GGUF-a
cache/
